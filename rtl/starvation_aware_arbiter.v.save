module starvation_aware_arbiter #(
    parameter N = 4,
    parameter AGE_WIDTH = 4,
    parameter AGE_THRESHOLD = 3
)(
    input  wire         clk,
    input  wire         rst,
    input  wire         ready,
    input  wire [N-1:0] req,
    output reg  [N-1:0] grant
);

    reg [1:0] rr_ptr;
    reg [AGE_WIDTH-1:0] age [0:N-1];

    integer k;
    integer idx;
    integer chosen;
    integer i;
    reg found;

    // Choose the oldest waiting requester first.
    // Round-robin order breaks ties.
    always @(*) begin
        grant  = {N{1'b0}};
        chosen = -1;
        found  = 1'b0;
        idx    = 0;

        for (k = 0; k < N; k = k + 1) begin
            idx = (rr_ptr + k) % N;
            if (!found && req[idx] &&
                age[idx] >= AGE_THRESHOLD) begin
                chosen = idx;
                found  = 1'b1;
            end
        end

        if (!found) begin
            for (k = 0; k < N; k = k + 1) begin
                idx = (rr_ptr + k) % N;
                if (!found && req[idx]) begin
                    chosen = idx;
                    found  = 1'b1;
                end
            end
        end

       
    

    // Age requests while they wait for service.
    // Reset the selected request's age when service is accepted.
    always @(posedge clk) begin
        if (rst) begin
            rr_ptr <= 0;
            for (i = 0; i < N; i = i + 1)
                age[i] <= 0;
        end else begin
            for (i = 0; i < N; i = i + 1) begin
                if (!req[i] || (ready && grant[i]))
                    age[i] <= 0;
                else if (!grant[i] && age[i] < AGE_THRESHOLD)
                    age[i] <= age[i] + 1'b1;
            end

            if (ready && chosen >= 0)
                rr_ptr <= (chosen + 1) % N;
        end
    end

endmodule
